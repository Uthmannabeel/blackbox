{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm --prefix .. run build && next build",
  "installCommand": "npm --prefix .. install",
  "crons": [
    {
      "path": "/api/cron/decay",
      "schedule": "17 3 * * *"
    },
    {
      "path": "/api/cron/drill",
      "schedule": "23 4 * * *"
    }
  ]
}
