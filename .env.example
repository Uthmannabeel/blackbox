# ---- CockroachDB Cloud ----
# Full connection string from the CockroachDB Cloud console (sql user).
# Multi-region cluster; the driver connects to the nearest gateway region.
DATABASE_URL="postgresql://blackbox:<password>@<host>:26257/blackbox?sslmode=verify-full"

# CockroachDB Cloud Managed MCP Server (org-wide endpoint — NOT per-cluster).
# The service account needs the Cluster Operator role or queries return
# "unauthorized". Cluster ID is the UUID from the Cloud console cluster page.
CRDB_MCP_URL="https://cockroachlabs.cloud/mcp"
CRDB_MCP_API_KEY="<service-account-api-key>"
CRDB_MCP_CLUSTER_ID="<cluster-uuid>"
# CRDB_MCP_DATABASE="blackbox"        # optional, defaults to blackbox

# ---- AWS Bedrock ----
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="<key>"
AWS_SECRET_ACCESS_KEY="<secret>"
# Reasoning model (Claude on Bedrock) and embedding model (Titan v2, 1024-dim).
# Use the exact model ID shown in YOUR Bedrock console's model catalog.
# If Converse errors with "on-demand throughput isn't supported", prepend the
# region prefix (inference profile), e.g. "us.anthropic.claude-sonnet-4-6".
BEDROCK_MODEL_ID="us.anthropic.claude-sonnet-4-6"
BEDROCK_EMBED_MODEL_ID="amazon.titan-embed-text-v2:0"

# ---- App ----
LOG_LEVEL="info"
# Database connect timeout (ms). Raise to ~45000 behind a slow corporate proxy.
# DB_CONNECT_TIMEOUT_MS="5000"

# ---- Trust boundary (memory write access) ----
# The public console has no login. Without this token EVERY session is
# untrusted, and anything the agent learns is QUARANTINED: stored and
# auditable, but never recalled by anyone else until an operator promotes it.
# Send the value as the `x-blackbox-operator` header to run a trusted session.
# Leave unset in public deployments unless you intend live learning.
# BLACKBOX_OPERATOR_TOKEN="<long-random-string>"

# Vercel Cron secret for the nightly memory-decay pass (/api/cron/decay).
# Without it the endpoint refuses to run rather than exposing a mutating route.
# CRON_SECRET="<long-random-string>"

# C-SPANN vector search beam width, applied in the connection startup packet.
# Higher = better recall, more work. 0 leaves the server default alone.
# VECTOR_BEAM_SIZE="64"
# Set to 1 to run fully offline (fake embeddings + in-memory store + scripted
# agent) with no CockroachDB/Bedrock calls. Leave unset/0 for real infra.
# BLACKBOX_MOCK="1"
